// Groundwork — the boilerplate schema.
//
// Nine models: the identity/RBAC core (User, Account, AuthSession,
// PasswordResetToken, UserRole, Role), the audit log, the file-asset registry,
// and Item — the example feature. Copy Item (and src/items) to start a real one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String
  avatar              String?
  password            String?
  emailVerifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// Consecutive failed logins, reset to 0 on any success. Feeds the lockout in
  /// AuthService.login — the part that bounds guesses when an attacker rotates
  /// IPs and so gets a fresh bucket from the per-(IP, email) rate limit.
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  roles               UserRole[]
  accounts            Account[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  bookings            Booking[]
}

/// A linked OAuth identity (e.g. Google). The backend owns provider linking;
/// the Next.js apps only run the redirect dance and exchange the profile here.
model Account {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  tokenType         String?
  scope             String?
  expiresAt         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model UserRole {
  id String @id @default(cuid())
  /// Cascades, like every other row hanging off a User. Without it a User can
  /// never be deleted — registration grants the USER role immediately, so every
  /// account has at least one of these and user.delete() fails on the foreign key.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role

  @@unique([userId, role])
  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
  USER
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model FileAsset {
  id           String    @id @default(cuid())
  bucket       String
  key          String    @unique
  visibility   String    @default("private") // "public" | "private"
  status       String    @default("PENDING") // "PENDING" | "READY"
  kind         String
  originalName String
  mimeType     String
  sizeBytes    Int       @default(0)
  url          String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([kind])
  @@index([status])
}

/// The example feature. Copy this model and src/items/ to start a real feature,
/// then delete both. Nothing else in the schema depends on it.
model Item {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String?
  published    Boolean   @default(false)
  imageFileIds String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([published])
}

/// Vehicle type group (SUV, Sedan, Van, …) — shown on customer site + admin.
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  vehicles    Vehicle[]
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  brand          String
  model          String
  year           Int
  seats          Int
  fuel           FuelType
  transmission   TransmissionType
  pricePerDay    Decimal           @db.Decimal(10, 2)
  status         VehicleStatus     @default(AVAILABLE)
  description    String?
  imageFileIds   String[]
  category       Category          @relation(fields: [categoryId], references: [id])
  categoryId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  bookings       Booking[]

  @@index([status])
  @@index([categoryId])
  @@index([pricePerDay])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  HANDED_OVER
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  PAYHERE
  KOKOPAY
  PAYZY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Booking {
  id             String           @id @default(cuid())
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  vehicleId      String
  firstName      String
  lastName       String
  phone          String
  email          String
  pickupDate     DateTime         @db.Date
  returnDate     DateTime         @db.Date
  pickupLocation String
  status         BookingStatus    @default(PENDING)
  /// Snapshot of pricePerDay * rental days at booking time (LKR).
  totalAmount    Decimal          @db.Decimal(10, 2)
  paymentMethod  PaymentProvider
  notes          String?
  cancelReason   String?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payment        Payment?

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDate, returnDate])
}

model Payment {
  id            String          @id @default(cuid())
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String          @unique
  amount        Decimal         @db.Decimal(10, 2)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([provider])
}
