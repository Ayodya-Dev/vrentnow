// Groundwork — the boilerplate schema.
//
// Nine models: the identity/RBAC core (User, Account, AuthSession,
// PasswordResetToken, UserRole, Role), the audit log, the file-asset registry,
// and Item — the example feature. Copy Item (and src/items) to start a real one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String
  avatar              String?
  password            String?
  emailVerifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// Consecutive failed logins, reset to 0 on any success. Feeds the lockout in
  /// AuthService.login — the part that bounds guesses when an attacker rotates
  /// IPs and so gets a fresh bucket from the per-(IP, email) rate limit.
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  /// When set, the account cannot sign in (password or OAuth). Cleared on enable.
  disabledAt          DateTime?
  roles               UserRole[]
  accounts            Account[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  bookings            Booking[]
  favourites          Favourite[]
  reviews             Review[]
  notifications       Notification[]
  damageReports       DamageReport[]

  @@index([disabledAt])
}

/// A linked OAuth identity (e.g. Google). The backend owns provider linking;
/// the Next.js apps only run the redirect dance and exchange the profile here.
model Account {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  tokenType         String?
  scope             String?
  expiresAt         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model UserRole {
  id String @id @default(cuid())
  /// Cascades, like every other row hanging off a User. Without it a User can
  /// never be deleted — registration grants the USER role immediately, so every
  /// account has at least one of these and user.delete() fails on the foreign key.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role

  @@unique([userId, role])
  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
  USER
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model FileAsset {
  id           String    @id @default(cuid())
  bucket       String
  key          String    @unique
  visibility   String    @default("private") // "public" | "private"
  status       String    @default("PENDING") // "PENDING" | "READY"
  kind         String
  originalName String
  mimeType     String
  sizeBytes    Int       @default(0)
  url          String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([kind])
  @@index([status])
}

/// The example feature. Copy this model and src/items/ to start a real feature,
/// then delete both. Nothing else in the schema depends on it.
model Item {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String?
  published    Boolean   @default(false)
  imageFileIds String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([published])
}

/// Vehicle type group (SUV, Sedan, Van, …) — shown on customer site + admin.
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  vehicles    Vehicle[]
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  brand          String
  model          String
  year           Int
  seats          Int
  fuel           FuelType
  transmission   TransmissionType
  pricePerDay    Decimal           @db.Decimal(10, 2)
  status         VehicleStatus     @default(AVAILABLE)
  description    String?
  imageFileIds   String[]
  category       Category          @relation(fields: [categoryId], references: [id])
  categoryId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  bookings       Booking[]
  favourites     Favourite[]
  reviews        Review[]

  @@index([status])
  @@index([categoryId])
  @@index([pricePerDay])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  HANDED_OVER
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  PAYHERE
  KOKOPAY
  PAYZY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Booking {
  id             String           @id @default(cuid())
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  vehicleId      String
  firstName      String
  lastName       String
  phone          String
  email          String
  pickupDate     DateTime         @db.Date
  returnDate     DateTime         @db.Date
  pickupLocation String
  status         BookingStatus    @default(PENDING)
  /// Snapshot of pricePerDay * rental days at booking time (LKR).
  totalAmount    Decimal          @db.Decimal(10, 2)
  paymentMethod  PaymentProvider
  notes          String?
  cancelReason   String?
  cancelledAt    DateTime?
  /// Private office photo of customer NIC (admin-only).
  nicFileId      String?
  /// Private office photo of driving licence (admin-only).
  licenceFileId  String?
  /// Signed rental agreement photo — customer may view this one.
  agreementFileId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payment        Payment?
  review         Review?
  damageReports  DamageReport[]

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDate, returnDate])
}

model Payment {
  id            String          @id @default(cuid())
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String          @unique
  amount        Decimal         @db.Decimal(10, 2)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([provider])
}

/// A vehicle saved to a customer's wishlist.
model Favourite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A customer review — one per completed booking. Public only when APPROVED.
model Review {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String       @unique
  /// 1–5 stars.
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([vehicleId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

/// An in-app message for a customer (booking confirmed, paid, etc.).
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

/// A damage / incident report filed by the customer for a booking.
model DamageReport {
  id          String    @id @default(cuid())
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  description String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([bookingId])
  @@index([userId])
  @@index([resolvedAt, createdAt])
}

/// A message submitted through the public contact form.
model Inquiry {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isRead, createdAt])
  @@index([deletedAt])
}

/// Marketing deal / promotion shown on the public Deals page (CMS).
model Deal {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  badge           String?
  description     String?
  /// Display string for the UI, e.g. "25% OFF".
  discountLabel   String
  code            String?   @unique
  imageFileId     String?
  /// Display string, e.g. "Valid until Aug 31, 2026".
  validUntilLabel String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
}
